{
  "openapi": "3.1.0",
  "info": {
    "title": "Mini API Hub",
    "version": "0.1.0",
    "description": "Original fictional order integration for learning. Every /api/ operation requires a local Hub Bearer key. Database migrations are explicit; startup does not migrate."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:3000",
      "description": "Local Hub"
    }
  ],
  "security": [
    {
      "HubKey": []
    }
  ],
  "paths": {
    "/health/live": {
      "get": {
        "operationId": "liveness",
        "security": [],
        "summary": "Prove that the process can answer HTTP, not that its database works.",
        "responses": {
          "200": {
            "description": "Process is answering",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "const": "ok"
                    },
                    "version": {
                      "const": "0.1.0"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "operationId": "readiness",
        "security": [],
        "summary": "Check the local database schema (does not establish upstream availability).",
        "responses": {
          "200": {
            "description": "Schema available",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "const": "ready"
                    }
                  }
                }
              }
            }
          },
          "503": {
            "description": "Schema unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "const": "not-ready"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/orders": {
      "get": {
        "operationId": "listOrders",
        "summary": "List orders, newest first.",
        "responses": {
          "200": {
            "description": "Saved orders",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "orders"
                  ],
                  "properties": {
                    "orders": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Order"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing or incorrect Bearer key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Database not migrated or unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "createOrder",
        "summary": "Save an order. Reference is unique; identical replay returns the saved order.",
        "description": "No upstream write occurs here. The send action is separate. Same reference plus different sku/quantity returns 409. Fields are validated server-side; UI validation is not authorization.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OrderInput"
              },
              "example": {
                "reference": "ORDER-001",
                "sku": "DESK-01",
                "quantity": 2
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Identical existing order returned",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrderResult"
                }
              }
            }
          },
          "201": {
            "description": "New order saved",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrderResult"
                }
              }
            }
          },
          "400": {
            "description": "Invalid JSON or order",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing or incorrect Bearer key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Reference reused with different data",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "Body larger than 16 KiB",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "415": {
            "description": "Content-Type must be application/json",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Database not migrated or unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/orders/{id}": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "get": {
        "operationId": "getOrder",
        "responses": {
          "200": {
            "description": "Saved order",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrderResult"
                }
              }
            }
          },
          "401": {
            "description": "Missing or incorrect Bearer key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Route or order not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Database not migrated or unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/orders/{id}/send": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "post": {
        "operationId": "sendOrder",
        "summary": "Send this saved order with its stable ID as the warehouse Idempotency-Key.",
        "description": "No body is required. Do not create a new order to retry. A lost response or 5xx leaves an uncertain outcome. The user deliberately retries the same saved order; there is no automatic retry loop. Warehouse responses are checked against the saved payload. A sent order is returned without another warehouse write.",
        "responses": {
          "200": {
            "description": "Confirmed matching warehouse order",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrderResult"
                }
              }
            }
          },
          "401": {
            "description": "Missing or incorrect Bearer key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Route or order not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "502": {
            "description": "Warehouse rejected, rate-limited, unavailable or returned untrusted data; inspect order.status and error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SendFailure"
                }
              }
            }
          },
          "503": {
            "description": "Database not migrated or unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "504": {
            "description": "Timed out. The warehouse may have saved the order; status is uncertain.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SendFailure"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "HubKey": {
        "type": "http",
        "scheme": "bearer",
        "description": "API_KEY from ignored .env, entered manually in the dashboard. Not WAREHOUSE_KEY."
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            }
          },
          "requestId": {
            "type": "string"
          }
        }
      },
      "OrderInput": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "reference",
          "sku",
          "quantity"
        ],
        "properties": {
          "reference": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
            "maxLength": 64
          },
          "sku": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
            "maxLength": 64
          },
          "quantity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          }
        }
      },
      "Order": {
        "type": "object",
        "required": [
          "id",
          "reference",
          "sku",
          "quantity",
          "status",
          "warehouse_id",
          "last_error",
          "created_at"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "reference": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
            "maxLength": 64
          },
          "sku": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
            "maxLength": 64
          },
          "quantity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "status": {
            "enum": [
              "pending",
              "sent",
              "uncertain",
              "failed"
            ]
          },
          "warehouse_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "last_error": {
            "type": [
              "string",
              "null"
            ]
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "OrderResult": {
        "type": "object",
        "required": [
          "order"
        ],
        "properties": {
          "order": {
            "$ref": "#/components/schemas/Order"
          },
          "requestId": {
            "type": "string"
          }
        }
      },
      "SendFailure": {
        "type": "object",
        "required": [
          "order",
          "error"
        ],
        "properties": {
          "order": {
            "$ref": "#/components/schemas/Order"
          },
          "error": {
            "type": "object",
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            }
          },
          "requestId": {
            "type": "string"
          }
        }
      }
    }
  }
}
