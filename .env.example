# Copy with npm run setup; setup replaces these placeholders with random keys.
# The hub key is for your browser; the warehouse key stays on the server.
API_KEY=GENERATE_WITH_NPM_RUN_SETUP
WAREHOUSE_KEY=GENERATE_WITH_NPM_RUN_SETUP
HOST=127.0.0.1
PORT=3000
WAREHOUSE_PORT=4000
WAREHOUSE_URL=http://127.0.0.1:4000
DATABASE_PATH=.data/hub.sqlite
WAREHOUSE_DATABASE_PATH=.data/warehouse.sqlite
REQUEST_TIMEOUT_MS=500
WAREHOUSE_MODE=normal
