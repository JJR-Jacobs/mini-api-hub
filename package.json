{
  "name": "mini-api-hub",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "A small integration app and hands-on lessons: set up, code, break, fix, test and deploy.",
  "type": "module",
  "engines": { "node": ">=24 <25" },
  "scripts": {
    "doctor": "node scripts/doctor.js",
    "setup": "node scripts/setup.js",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.js",
    "dev": "node --env-file-if-exists=.env scripts/dev.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "warehouse": "node --env-file-if-exists=.env src/warehouse.js",
    "test": "node --test tests/*.test.js",
    "check": "node scripts/check.js",
    "backup": "node --env-file-if-exists=.env scripts/backup.js",
    "restore": "node --env-file-if-exists=.env scripts/restore.js",
    "lab": "node scripts/lab.js"
  }
}
